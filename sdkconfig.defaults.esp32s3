# Magic Badge - ESP32-S3 Target Configuration
CONFIG_IDF_TARGET="esp32s3"

# Flash 16MB + QIO
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# CPU 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM 8MB Octal
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_SPIRAM_MEMTEST=n

# WiFi memory optimization
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_MAX_SOCKETS=32

# TLS optimization (PSRAM allocation + small buffers)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# SPIFFS filename/object limit (supports longer skill filenames)
CONFIG_SPIFFS_OBJ_NAME_LEN=64

# Console: UART primary (non-blocking), USB Serial/JTAG secondary
# Prevents device hang when no USB host is connected (issue #60)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Set the stack size for the timer task
CONFIG_ESP_TIMER_TASK_STACK_SIZE=8192

# camera 
CONFIG_CAMERA_PSRAM_DMA=y

# Enable Bluetooth with NimBLE stack
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=24
# The ACL buffers must be at least as large as the ATT MTU the firmware asks for
# (BUDDY_CHAT_ATT_MTU = 247 in main/buddy/buddy_ble.c).  They were left at the
# Kconfig default of 64 while the ATT layer negotiated 247, so any ATT response
# that did not fit in a single 64-byte fragment never came back: both ends sat
# in the procedure until the ~30 s ATT timeout.  The tell-tale was that the same
# read-by-type succeeded with a 44-byte response and failed with a 71-byte one.
# 251 = 247 + 4 (L2CAP header), i.e. one full MTU-sized PDU per buffer.
CONFIG_BT_NIMBLE_ACL_BUF_SIZE=251
CONFIG_BT_NIMBLE_TRANSPORT_ACL_SIZE=251

# NimBLE host task stack.  The default is 4096, and this firmware puts real work
# on that task: the GATT access callbacks, the profile exchange, and the
# disconnect handler all run there, and the profile fields they handle are
# hundreds of bytes each.  Two 1 KB locals in that path — well under the biggest
# buffer the code was allowed to use — overflowed 4096 and rebooted the badge on
# every disconnect.  8192 leaves room for the field-sized buffers this path may
# legitimately need without turning a routine edit into a crash.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
