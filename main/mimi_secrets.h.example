/*
 * Magic Badge Build-time Secrets
 *
 * Layer 1 (compile-time) configuration. Runtime settings can also be
 * changed later via the web portal or CLI — see config.md.
 * Copy this file to mimi_secrets.h and fill in your values.
 * After any change, rebuild: idf.py fullclean && idf.py build
 *
 *   cp mimi_secrets.h.example mimi_secrets.h
 */

#pragma once

/* WiFi */
#define MIMI_SECRET_WIFI_SSID       ""
#define MIMI_SECRET_WIFI_PASS       ""

/* Telegram Bot */
#define MIMI_SECRET_TG_TOKEN        ""

/* Feishu Bot */
#define MIMI_SECRET_FEISHU_APP_ID   ""
#define MIMI_SECRET_FEISHU_APP_SECRET ""

/* LLM API — set MIMI_SECRET_MODEL_PROVIDER to one of:
 *   "anthropic"  — api.anthropic.com   (default)
 *   "openai"     — api.openai.com
 *   "openrouter" — openrouter.ai       (free tier available)
 *   "nvidia"     — integrate.api.nvidia.com (NVIDIA NIM, free tier available)
 *   "qwen"       — dashscope.aliyuncs.com/compatible-mode/v1
 */
#define MIMI_SECRET_API_KEY         ""
#define MIMI_SECRET_MODEL           ""
#define MIMI_SECRET_MODEL_PROVIDER  "anthropic"

/* HTTP Proxy (leave empty or set both) */
#define MIMI_SECRET_PROXY_HOST      ""
#define MIMI_SECRET_PROXY_PORT      ""

/* Web Search API — set MIMI_SECRET_SEARCH_PROVIDER to one of:
 *   "tavily"  — api.tavily.com       (default)
 *   "brave"   — api.search.brave.com  (optional)
 */
#define MIMI_SECRET_SEARCH_KEY      ""
#define MIMI_SECRET_SEARCH_PROVIDER "tavily"
